# UbuntuBio Deployment Environment Variables

# Single Root Storage Path
UBUNTUBIO_DATA_DIR=/srv/ubuntubio/data

# Domain & Host Configuration
UBUNTUBIO_DOMAIN=localhost
UBUNTUBIO_API_URL=http://localhost:8000
UBUNTUBIO_WEB_URL=http://localhost:3000
UBUNTUBIO_CAS_URL=http://localhost:8080

# Database (Embedded Asynchronous SQLite with FTS5 Search & WAL Mode)
DATABASE_URL=sqlite+aiosqlite:////srv/data/ubuntubio.db

# OpenXet CAS
OPENXET_HOST=0.0.0.0
OPENXET_PORT=8080
OPENXET_AUTH_ENABLED=false
OPENXET_OIDC_ISSUERS=http://server:8000

# Security & JWT Token Signing
JWT_SECRET_KEY=dev_insecure_jwt_secret_change_in_production
JWT_ALGORITHM=RS256
